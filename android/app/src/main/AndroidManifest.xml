        <!-- CAPACITOR (2026-09-05, @capacitor-mlkit/barcode-scanning) :
             déclare le module ML Kit "barcode_ui" nécessaire à scan() —
             voir scanQrNative() dans app.js. Sans ça, isGoogleBarcodeScanner
             ModuleAvailable() ne trouve jamais rien à installer. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui"/>
    </application>

    <!-- Permissions -->
    <!-- CAMERA/RECORD_AUDIO : getUserMedia({video,audio:true}) dans la vue
         caméra maison (photos/documents) et le scanner QR (voir app.js,
         ligne ~8411 et ~3351) — sans ces déclarations, la demande web
         échoue silencieusement dans la WebView au lieu d'afficher la boîte
         de dialogue de permission Android. ACCESS_FINE/COARSE_LOCATION :
         navigator.geolocation (météo, "ma position" sur la carte, toilettes
         à proximité) — voir la note "Géolocalisation" en tête d'app.js;
         fonctionne mais reste marqué comme "à vérifier sur appareil réel"
         tant qu'aucun plugin natif n'est ajouté. READ_MEDIA_IMAGES
         (Android 13+, 2026-09-05) : @capacitor-community/media doit
         pouvoir lister les albums existants (getAlbums()) avant de créer
         "Tabi Go" — voir ensureNativePhotoAlbum() dans app.js.
         READ/WRITE_CALENDAR (2026-09-05) : @ebarooni/capacitor-calendar
         doit pouvoir trouver le calendrier par défaut (getDefaultCalendar)
         et y écrire (createEvent) — voir addPlanningToNativeCalendar()
         dans app.js. La demande d'autorisation à l'exécution reste gérée
         par le plugin (requestFullCalendarAccess()), ces déclarations ne
         font que rendre la permission disponible à demander. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
