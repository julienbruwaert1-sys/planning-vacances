        android:theme="@style/AppTheme">
        <!-- CAPACITOR (2026-09-05, @capawesome/capacitor-app-icon) : l'icône
             de lancement change vraiment selon le choix dans Réglages via
             ces activity-alias, PAS l'icône statique de .MainActivity —
             voir applyAppIcon() dans app.js. L'intent-filter LAUNCHER a
             donc été déplacé de .MainActivity vers l'alias .default
             (activé par défaut) : exactement un alias doit être activé à
             la fois, le plugin gère lui-même l'activation/désactivation
             des autres via PackageManager. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
        </activity>

        <activity-alias
