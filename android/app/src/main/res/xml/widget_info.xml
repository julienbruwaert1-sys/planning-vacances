<?xml version="1.0" encoding="utf-8"?>
<!-- CAPACITOR (2026-09-06) : métadonnées du widget d'écran d'accueil — voir
     TripWidgetProvider.java et le <receiver> dans AndroidManifest.xml.
     updatePeriodMillis à 30 min (le minimum réellement imposé par Android)
     ne sert que de filet de sécurité si l'appli reste fermée longtemps : le
     vrai rafraîchissement instantané vient du push JS via HomeWidgetPlugin
     (voir updateHomeWidgetData() dans app.js), pas de ce cycle périodique.
     minHeight="110dp" (constaté sur appareil réel) : le lanceur alloue la
     cellule UNE FOIS à l'ajout du widget, sans jamais la ré-agrandir si le
     contenu s'allonge ensuite (ex. la ligne "prochaine activité" qui
     n'existe pas dans l'état vide affiché au tout premier rendu) — la
     valeur doit donc couvrir le cas le PLUS rempli (5 lignes avec la
     bordure de feuilles Momiji : bordure, nom, gros nombre, légende,
     prochaine activité), pas le cas vide. Différent du souci inverse
     rencontré avec l'ancienne mise en page (3 lignes) : une valeur trop
     généreuse pour SON contenu laissait un grand vide — ici c'est la bonne
     taille pour CE contenu-ci.

     previewLayout (2026-09-13, API 31+) : l'écran "Widgets" du lanceur
     rend désormais EN DIRECT ce layout (avec ses vraies valeurs
     android:text, ajoutées à côté de chaque tools:text existant dans
     widget_trip.xml pour cet usage précis — remplacées comme d'habitude
     par RemoteViews.setTextViewText() une fois le widget réellement posé,
     donc sans aucun effet une fois en place) au lieu d'une simple icône
     d'appli identique pour les 5 widgets — signalé par l'utilisateur,
     impossible de distinguer les widgets entre eux dans le sélecteur.
     previewImage reste en repli pour les appareils encore en dessous
     d'Android 12. -->

<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="126dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_trip"
    android:previewLayout="@layout/widget_trip"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_trip_label" />
