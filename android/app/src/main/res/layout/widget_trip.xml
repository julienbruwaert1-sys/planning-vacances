<?xml version="1.0" encoding="utf-8"?>
<!-- CAPACITOR (2026-09-06, widget écran d'accueil, style "B2 nuit étoilée")
     RemoteViews ne supporte qu'un sous-ensemble limité de vues
     (LinearLayout, RelativeLayout, FrameLayout, GridLayout — pas
     ConstraintLayout). FrameLayout en racine + LinearLayout interne en
     wrap_content : centre le bloc de texte quelle que soit la taille de
     cellule accordée par le lanceur (vérifié correct via aapt2 dump
     xmltree — le vrai souci de "widget mal centré" rencontré sur appareil
     réel était une taille par défaut trop généreuse dans widget_info.xml,
     pas ce centrage). Le fond (@drawable/widget_bg_default ici) est
     remplacé au rendu selon le thème actif de l'appli — voir
     TripWidgetProvider.themeColors(). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <!-- Bordure décorative façon guirlande (mockup "M4"), visible
             seulement pour le thème Momiji — voir themeLeafBand() dans
             TripWidgetProvider.java. GONE par défaut (autres thèmes). -->
        <TextView
            android:id="@+id/widgetLeafBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:visibility="gone"
            tools:text="🍁  🍂  🍁"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/widgetTripName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CFE0F0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Japon" />

        <TextView
            android:id="@+id/widgetBigNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0935A"
            android:textSize="34sp"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="9" />

        <TextView
            android:id="@+id/widgetCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B9C8D6"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="jours avant le départ" />

        <TextView
            android:id="@+id/widgetNextActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#E4ECF3"
            android:textSize="10.5sp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="09:00 · Visite du musée" />

    </LinearLayout>

</FrameLayout>
