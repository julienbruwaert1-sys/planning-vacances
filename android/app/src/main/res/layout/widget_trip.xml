<?xml version="1.0" encoding="utf-8"?>
<!-- CAPACITOR (2026-09-06, widget d'écran d'accueil, voir
     TripWidgetProvider.java) : RemoteViews (mécanisme de rendu des widgets)
     ne supporte qu'un sous-ensemble limité de vues (LinearLayout,
     RelativeLayout, FrameLayout, GridLayout — pas ConstraintLayout).
     FrameLayout en racine + LinearLayout interne en wrap_content : un
     android:gravity posé directement sur une racine match_parent n'est pas
     toujours respecté par tous les lanceurs (constaté sur appareil réel,
     OneUI Samsung) — le contenu restait collé en haut malgré
     gravity="center_vertical". Ce schéma (racine FrameLayout qui porte le
     fond + bloc interne wrap_content centré via layout_gravity) est le
     contournement standard pour ce problème connu de RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widgetTripName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#33404A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Voyage au Japon" />

        <TextView
            android:id="@+id/widgetCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5B7A8C"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Départ dans 12 jours" />

        <TextView
            android:id="@+id/widgetNextActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#33404A"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="09:30 · Visite du musée" />

    </LinearLayout>

</FrameLayout>
