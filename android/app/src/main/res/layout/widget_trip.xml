<?xml version="1.0" encoding="utf-8"?>
<!-- CAPACITOR (2026-09-06, widget écran d'accueil, style "B2 nuit étoilée")
     RemoteViews ne supporte qu'un sous-ensemble limité de vues
     (LinearLayout, RelativeLayout, FrameLayout, GridLayout — pas
     ConstraintLayout). FrameLayout en racine + LinearLayout interne en
     wrap_content : centre le bloc de texte quelle que soit la taille de
     cellule accordée par le lanceur (vérifié correct via aapt2 dump
     xmltree — le vrai souci de "widget mal centré" rencontré sur appareil
     réel était une taille par défaut trop généreuse dans widget_info.xml,
     pas ce centrage). Le fond (@drawable/widget_bg_default ici) est
     remplacé au rendu selon le thème actif de l'appli — voir
     TripWidgetProvider.themeColors(). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_default"
    android:clipToOutline="true">

    <!-- Photo réelle (style "P2 sans assombrissement", choisi parmi la
         comparaison de mockups) — Sakura/Momiji/Ghibli/Halloween/Néon, voir
         WidgetThemeColors.photoRes(). scaleType="centerCrop" : remplit le
         widget en conservant les proportions, quelle que soit sa taille
         réelle (contrairement à widgetScene en fitXY, qui convient à une
         silhouette dessinée mais déformerait une vraie photo). GONE pour
         les autres thèmes (widget_bg_default/thème reprend alors la main
         comme fond). Pas de voile sombre par-dessus (essayé, retiré à la
         demande) — la lisibilité du texte vient de l'ombre portée posée
         sur chaque TextView plus bas, pas d'un assombrissement de la
         photo. -->
    <ImageView
        android:id="@+id/widgetPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        tools:src="@drawable/widget_photo_sakura"
        tools:visibility="visible" />

    <!-- Scène "H3 nuit étoilée" (lune/étoiles/montagnes), thème "default"
         uniquement — voir widget_scene_default.xml. scaleType="fitXY" :
         s'étire pour remplir le widget quelle que soit sa taille réelle,
         comme le mockup HTML (preserveAspectRatio="none"). clipToOutline
         sur le FrameLayout parent évite que les coins de l'image ne
         dépassent des coins arrondis du fond. -->
    <ImageView
        android:id="@+id/widgetScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scene_default" />

    <LinearLayout
        android:id="@+id/widgetContentBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <!-- Bordure décorative façon guirlande (mockup "M4"), visible
             seulement pour le thème Momiji — voir themeLeafBand() dans
             TripWidgetProvider.java. GONE par défaut (autres thèmes). -->
        <TextView
            android:id="@+id/widgetLeafBand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:visibility="gone"
            android:shadowColor="#D0000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="0"
            tools:text="🍁  🍂  🍁"
            tools:visibility="visible" />

        <!-- Halo (pas une ombre portée directionnelle) : shadowDx/Dy à 0
             et un rayon plus large donne un contour sombre SYMÉTRIQUE
             autour du texte plutôt qu'un décalage d'un côté — la même
             technique que les sous-titres de film, plus robuste qu'une
             ombre classique contre une photo non uniforme (clair d'un
             côté, sombre de l'autre). Remplace le fond translucide
             derrière le bloc de texte (retiré à la demande, 2026-09-06) :
             un même layout partagé par tous les thèmes, inoffensif pour
             les thèmes déjà lisibles (Halloween/Néon/défaut). -->
        <TextView
            android:id="@+id/widgetTripName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5F8FB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#D0000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="0"
            tools:text="Japon" />

        <!-- Barre lumineuse (mockup "N2"), thème Néon uniquement — voir
             TripWidgetProvider.java. ImageView plutôt qu'un simple View
             brut : RemoteViews n'accepte officiellement qu'un sous-ensemble
             de vues, et View n'en fait pas partie (contrairement à
             ImageView). -->
        <ImageView
            android:id="@+id/widgetNeonGlow"
            android:layout_width="34dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_neon_glow"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Halo renforcé (#FF, opaque) et plus large que le reste du
             texte : le nombre est l'élément le plus gros/le plus au centre
             de la carte, donc le plus exposé à un objet clair de la photo
             pile dans sa zone (ex. boule de Noël argentée) — verif
             lisibilité 2026-09-06. -->
        <TextView
            android:id="@+id/widgetBigNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0935A"
            android:textSize="34sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#FF000000"
            android:shadowRadius="9"
            android:shadowDx="0"
            android:shadowDy="0"
            tools:text="9" />

        <TextView
            android:id="@+id/widgetCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F5F8FB"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#D0000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="0"
            tools:text="jours avant le départ" />

        <TextView
            android:id="@+id/widgetNextActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F5F8FB"
            android:textSize="10.5sp"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#D0000000"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="0"
            tools:text="09:00 · Visite du musée" />

    </LinearLayout>

</FrameLayout>
