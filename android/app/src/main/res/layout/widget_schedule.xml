<?xml version="1.0" encoding="utf-8"?>
<!-- CAPACITOR (2026-09-08) : widget "Programme du jour" — timeline mini du
     jour de voyage EN COURS (pas juste la prochaine activité comme la carte
     compte à rebours). FrameLayout + LinearLayout wrap_content interne,
     même schéma que widget_trip.xml/widget_tricount_pill.xml. 4 lignes
     fixes (RemoteViews ne permet pas de ListView sans un RemoteViewsService
     dédié, hors de propos pour un maximum de 4 activités) — les lignes en
     trop restent simplement masquées (visibility GONE), voir
     ScheduleWidgetProvider.java. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/scheduleDayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#F3F1EC"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="📅 Jour 5 · Kyoto" />

        <TextView
            android:id="@+id/scheduleEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D8DEE8"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Aucune activité aujourd'hui" />

        <LinearLayout
            android:id="@+id/scheduleRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <TextView
                android:id="@+id/scheduleTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0935A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                tools:text="09:00" />
            <TextView
                android:id="@+id/scheduleTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#F3F1EC"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="🏛️ Temple Kinkaku-ji" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scheduleRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <TextView
                android:id="@+id/scheduleTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0935A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                tools:text="12:30" />
            <TextView
                android:id="@+id/scheduleTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#F3F1EC"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="🍜 Déjeuner à Nishiki" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scheduleRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp">
            <TextView
                android:id="@+id/scheduleTime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0935A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                tools:text="15:00" />
            <TextView
                android:id="@+id/scheduleTitle3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#F3F1EC"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="🎎 Marché de Nishiki" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scheduleRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/scheduleTime4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0935A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                tools:text="19:00" />
            <TextView
                android:id="@+id/scheduleTitle4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="#F3F1EC"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="🍶 Izakaya du soir" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
