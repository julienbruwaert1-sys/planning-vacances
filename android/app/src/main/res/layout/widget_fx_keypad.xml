<?xml version="1.0" encoding="utf-8"?>
<!-- Widget convertisseur avec clavier (2026-11-08) : on tape le montant directement dans le widget, sans ouvrir
     l'appli. Calcul natif (FxWidgetProvider) avec le dernier taux envoyé par l'appli (HomeWidgetPlugin KEY_FX_RATE).
     Utilisé quand le widget est assez grand ; sinon widget_fx.xml (affichage seul). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fxRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="7dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/fxPair" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#D8DEE8" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
                android:text="💱 £ → Ft" />
            <TextView android:id="@+id/fxInput" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#D8DEE8" android:textSize="12sp" android:maxLines="1" android:text="1 £ =" />
        </LinearLayout>

        <TextView android:id="@+id/fxResult" android:layout_width="match_parent" android:layout_height="28dp"
            android:gravity="end|center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
            android:textColor="#F0935A" android:textStyle="bold" android:maxLines="1"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="22sp"
            android:text="436 Ft" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/k7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="7" />
            <TextView android:id="@+id/k8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="8" />
            <TextView android:id="@+id/k9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="9" />
            <TextView android:id="@+id/kDel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key_action" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="⌫" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/k4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="4" />
            <TextView android:id="@+id/k5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="5" />
            <TextView android:id="@+id/k6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="6" />
            <TextView android:id="@+id/kClear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key_action" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="C" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/k1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="1" />
            <TextView android:id="@+id/k2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="2" />
            <TextView android:id="@+id/k3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="3" />
            <TextView android:id="@+id/kSwap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key_action" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="⇄" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/k0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="0" />
            <TextView android:id="@+id/kComma" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="," />
            <TextView android:id="@+id/kOpen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_margin="2dp" android:background="@drawable/widget_fx_key_action" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:text="↗" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
